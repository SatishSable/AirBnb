<% layout("layouts/boilerplate")%>

    <style>
        .listing-show {
            max-width: 1000px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .listing-header {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .listing-image {
            border-radius: 16px;
            overflow: hidden;
            height: 450px;
            position: relative;
        }

        .listing-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .listing-image-overlay {
            position: absolute;
            bottom: 1rem;
            right: 1rem;
            background: rgba(255,255,255,0.9);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }

        .listing-info h1 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            line-height: 1.2;
        }

        .listing-location {
            color: #717171;
            margin-bottom: 1rem;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .listing-specs {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .spec-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem;
            background: #f7f7f7;
            border-radius: 12px;
        }

        .spec-item i {
            font-size: 1.5rem;
            color: #FF385C;
        }

        .spec-item div {
            display: flex;
            flex-direction: column;
        }

        .spec-item span:first-child {
            font-size: 0.75rem;
            color: #717171;
            text-transform: uppercase;
        }

        .spec-item span:last-child {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .listing-price-card {
            background: white;
            padding: 1.5rem;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            margin-top: 1.5rem;
            border: 1px solid #f0f0f0;
        }

        .price-display {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .price-display small {
            font-size: 1rem;
            color: #717171;
            font-weight: 400;
        }

        .book-btn {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, #FF385C, #E31C5F);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .book-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(255, 56, 92, 0.3);
        }
        
        /* Date Inputs specialized */
        .date-grid {
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 0.5rem; 
            margin-bottom: 1rem;
        }
        
        .date-input-wrapper label {
            font-size: 0.7rem; 
            font-weight: 700;
            color: #717171; 
            display: block; 
            margin-bottom: 0.25rem;
            text-transform: uppercase;
        }
        
        .date-input-wrapper input, .guest-select {
            width: 100%; 
            padding: 0.75rem; 
            border: 1px solid #ddd; 
            border-radius: 8px;
            font-family: var(--font-sans);
        }

        .listing-description {
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid #ebebeb;
        }

        .listing-description h2 {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        .listing-description p {
            line-height: 1.6;
            color: #444;
        }

        .listing-features {
            margin-top: 2rem;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .feature-tag {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem;
            background: #f7f7f7;
            border-radius: 8px;
        }

        .feature-tag i {
            color: #00A699;
        }
        
        /* Reviews Styles adapted */
        .reviews-section {
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid #ebebeb;
        }
        
        .review-card {
            background: #FAFAFA;
            padding: 1.5rem;
            border-radius: 12px;
            margin-bottom: 1rem;
        }
        
        .review-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 0.5rem;
        }
        
        .review-avatar {
            width: 40px; 
            height: 40px; 
            background: #222; 
            color: white; 
            border-radius: 50%;
            display: flex; 
            align-items: center; 
            justify-content: center;
            font-weight: 600;
        }

        @media (max-width: 900px) {
            .listing-header {
                grid-template-columns: 1fr;
            }

            .listing-image {
                height: 300px;
            }
        }
    </style>

    <div class="listing-show">
        <a href="/listings" style="color: #FF385C; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
            <i class="fas fa-arrow-left"></i> Back to Stays
        </a>

        <div class="listing-header">
            <!-- Left Column: Image -->
            <div class="listing-image">
                <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1571003123894-1f0594d2b5d9?w=800' %>"
                    alt="<%= listing.title %>">
                <% if(listing.images && listing.images.length > 1) { %>
                    <div class="listing-image-overlay">
                        <i class="fas fa-images"></i> +<%= listing.images.length - 1 %> photos
                    </div>
                <% } %>
            </div>

            <!-- Right Column: Info & Booking -->
            <div class="listing-info">
                <span style="background: #f0f0f0; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.8rem; text-transform: capitalize; font-weight: 600; color: #555;">
                    <%= listing.propertyType || 'Entire place' %>
                </span>
                
                <h1><%= listing.title %></h1>
                
                <p class="listing-location">
                    <i class="fas fa-map-marker-alt" style="color: #FF385C;"></i>
                    <%= listing.mapboxPlaceName ? listing.mapboxPlaceName : (listing.location + ", " + listing.country) %>
                </p>

                <div class="listing-specs">
                    <div class="spec-item">
                        <i class="fas fa-user-friends"></i>
                        <div>
                            <span>Capacity</span>
                            <span><%= listing.guests || 2 %> Guests</span>
                        </div>
                    </div>
                    <div class="spec-item">
                        <i class="fas fa-bed"></i>
                        <div>
                            <span>Bedrooms</span>
                            <span><%= listing.bedrooms || 1 %> Room</span>
                        </div>
                    </div>
                    <div class="spec-item">
                        <i class="fas fa-bath"></i>
                        <div>
                            <span>Bathrooms</span>
                            <span><%= listing.bathrooms || 1 %> Bath</span>
                        </div>
                    </div>
                    <div class="spec-item">
                        <i class="fas fa-star"></i>
                        <div>
                            <span>Rating</span>
                            <span>4.8 (Verified)</span>
                        </div>
                    </div>
                </div>

                <div class="listing-price-card">
                    <div class="price-display">
                        <span>₹<%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %> <small>/ night</small></span>
                    </div>
                    
                    <% if(currUser) { %>
                        <form action="/listings/<%= listing._id %>/book" method="POST">
                            <div class="date-grid">
                                <div class="date-input-wrapper">
                                    <label>Check-In</label>
                                    <input type="date" name="checkIn" required min="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                                <div class="date-input-wrapper">
                                    <label>Check-Out</label>
                                    <input type="date" name="checkOut" required min="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                            </div>
                            
                            <div style="margin-bottom: 1rem;">
                                <label style="font-size: 0.7rem; font-weight: 700; color: #717171; display: block; margin-bottom: 0.25rem; text-transform: uppercase;">GUESTS</label>
                                <select name="guests" class="guest-select">
                                    <% for(let i=1; i<= (listing.guests || 5); i++) { %>
                                        <option value="<%= i %>"><%= i %> Guest<%= i>1?'s':'' %></option>
                                    <% } %>
                                </select>
                            </div>

                            <button type="submit" class="book-btn">
                                <i class="fas fa-bolt"></i> Reserve Now
                            </button>
                            <p style="text-align: center; color: #777; font-size: 0.8rem; margin-top: 0.5rem;">You won't be charged yet</p>
                        </form>
                    <% } else { %>
                        <a href="/login" class="book-btn" style="display: block; text-align: center; text-decoration: none;">
                            Login to Book
                        </a>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Description -->
        <% if(listing.description) { %>
            <div class="listing-description">
                <h2>About this place</h2>
                <p><%= listing.description %></p>
            </div>
        <% } %>

        <!-- Amenities -->
        <% if(listing.amenities && listing.amenities.length > 0) { %>
            <div class="listing-features">
                <h2>What this feature offers</h2>
                <div class="features-grid">
                    <% listing.amenities.forEach(amenity => { %>
                        <div class="feature-tag">
                            <i class="fas fa-check-circle"></i>
                            <span><%= amenity %></span>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <!-- Host Info -->
        <% if(listing.owner) { %>
            <div style="margin-top: 2rem; padding: 1.5rem; background: #f7f7f7; border-radius: 16px;">
                <h3 style="margin-bottom: 1rem;">Hosted by</h3>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #FF385C, #E31C5F); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 1.25rem;">
                        <%= listing.owner.username.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                        <p style="font-weight: 600; margin: 0;"><%= listing.owner.username %></p>
                        <p style="color: #717171; font-size: 0.875rem; margin: 0;">Superhost</p>
                    </div>
                </div>

                <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
                    <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #ddd; display: flex; gap: 1rem;">
                        <a href="/listings/<%= listing._id %>/edit" style="flex: 1; padding: 0.75rem 1.5rem; background: #222; color: white; text-align: center; text-decoration: none; border-radius: 8px; font-weight: 600; transition: all 0.3s ease;">
                            <i class="fas fa-edit"></i> Edit Listing
                        </a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="flex: 1;">
                            <button type="submit" style="width: 100%; padding: 0.75rem 1.5rem; background: #e74c3c; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.3s ease;" onclick="return confirm('Delete this listing?');">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- Map Section -->
        <div style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #ebebeb;">
            <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem;">Where you'll be</h2>
            <p style="color: #717171; margin-bottom: 1rem;">
                <i class="fas fa-map-marker-alt"></i>
                <%= listing.mapboxPlaceName ? listing.mapboxPlaceName : listing.location %>
            </p>
            <div id="map" style="height: 350px; border-radius: 16px; overflow: hidden; background: #e9e9e9;"></div>
        </div>
        
        <!-- Reviews (Kept but styled simply) -->
         <div class="reviews-section">
            <h2 style="margin-bottom: 1.5rem;">Reviews ★ <%= listing.reviews.length %></h2>
            <% if(listing.reviews && listing.reviews.length > 0) { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem;">
                    <% for(let review of listing.reviews) { %>
                        <div class="review-card">
                            <div class="review-header">
                                <div class="review-avatar"><%= review.author.username.charAt(0) %></div>
                                <div>
                                    <div style="font-weight: 600;"><%= review.author.username %></div>
                                    <div style="font-size: 0.8rem; color: #888;"><%= new Date(review.createdAt).toLocaleDateString() %></div>
                                </div>
                            </div>
                            <p style="color: #444; font-size: 0.9rem;"><%= review.comment %></p>
                            <div style="color: #FF385C; font-size: 0.8rem;">
                                <% for(let i=0; i<review.rating; i++) { %>★<% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <p>No reviews yet.</p>
            <% } %>
            
             <% if(currUser) { %>
                <div style="margin-top: 2rem;">
                  <h3>Leave a review</h3>
                  <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
                    <div style="margin-bottom: 1rem;">
                        <label class="form-label">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div style="margin-bottom: 1rem;">
                        <textarea name="review[comment]" rows="3" class="form-control" required placeholder="Write your experience..." style="width:100%; padding: 0.75rem; border-radius: 8px; border: 1px solid #ddd;"></textarea>
                    </div>
                    <button class="book-btn" style="width: auto; padding: 0.75rem 2rem;">Post Review</button>
                  </form>
                </div>
            <% } %>
         </div>

    </div>

    <script>
        var maptoken = "<%- mapBoxToken || '' %>";
        var listing = <%- JSON.stringify(listing) %>;
    </script>
    <script src="/js/map.js"></script>